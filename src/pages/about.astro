---
// src/pages/about.astro
// About page styled to match the rest of the site.
const navItems = ["Home", "Features", "About", "Support", "Download"];
const activeItem = "About";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About | Brain of Bike</title>
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-logo2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <img class="brand-mark" src="/Logo3.png" alt="Brain of Bike logo" />
        <img class="secondary-mark" src="/Logo4.png" alt="Brain of Bike secondary logo" />
      </a>

      <nav class="nav">
        {navItems.map((item) => {
          const href = item === "Home" ? "/" : item === "Features" ? "/features" : item === "About" ? "/about" : item === "Support" ? "/support" : item === "Download" ? "/download" : "#";
          return <a href={href} class:list={["nav-pill", { active: item === activeItem }]}>{item}</a>;
        })}
      </nav>
    </header>

    <main class="about-page">
      <section class="story-block">
        <p class="eyebrow">About</p>
        <h1>Meet the Brains Behind the Bike</h1>

        <p>
          <strong>Brain of Bike</strong> is brought to you by <strong>Made by CKT Ltd</strong> — a small creative business with big ideas,
          questionable amounts of enthusiasm, and a habit of turning “wouldn’t it be cool if…” into actual apps.
        </p>

        <p>
          Made by <strong>Katie Mayers</strong>, the designer, and <strong>Chris Hill</strong>, the developer, CKT brings together two very different brains to create apps
          that are useful, playful, and occasionally a little chaotic.
        </p>

        <p>
          <strong>Brain of Bike is our first adventure.</strong>
        </p>

        <p>
          It brings together Chris’s love of motorbike riding with Katie’s love of tracking adventures, collecting data, and probably making a spreadsheet about it.
        </p>

        <p>
          One loves the open road.<br />
          The other loves knowing exactly where that road went.<br />
          Somewhere in the middle, Brain of Bike happened.
        </p>

        <p>
          We wanted to create something that makes riding more than just getting from A to B — a way to keep track of the journeys, discover more about your rides,
          and look back on the adventures along the way.
        </p>

        <p>
          And as for the two people behind it...
        </p>

        <blockquote>
          Some say the perfect couple doesn’t exist.<br />
          <strong>We think they might have a point.</strong><br />
          But we did make an app together, so we’ll take that as a win.
        </blockquote>

        <h2>Made by CKT</h2>

        <p>
          Brain of Bike is just the beginning. Made by CKT is where <strong>creative ideas, slightly chaotic thinking, and a love of building things</strong> come together.
        </p>

        <p>
          Who knows what we’ll make next?<br />
          We’re not entirely sure either.
        </p>
      </section>

      <section class="brand-box">
        <p class="brand-box-label">Brought to you by</p>
        <a class="brand-link" href="https://madebyckt.com" target="_blank" rel="noreferrer noopener">
          <img class="brand-box-logo" src="/Made by CKT.png" alt="Made by CKT logo" />
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <p>Brain of bike · Made by CKT Ltd · Company No. 17451719 · Registered in England &amp; Wales · <a href="mailto:support@madebyckt.com">support@madebyckt.com</a> © 2026</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #eef3f8;
    --navy: #2b3d4f;
    --accent: #8fb0c7;
    --accent-soft: #d7e4ed;
    --pill: #dbe6ef;
    --pill-text: #6d818f;
    --white: #ffffff;
    --card-bg: rgba(255, 255, 255, 0.7);
    --border: rgba(43, 61, 79, 0.08);
    --text: #2b3d4f;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    font-family: "Poppins", sans-serif;
    color: var(--text);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px 0;
    flex-wrap: wrap;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: auto;
    height: 72px;
    object-fit: contain;
  }

  .secondary-mark {
    display: block;
    width: auto;
    height: 120px;
    object-fit: contain;
  }

  .nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nav-pill {
    text-decoration: none;
    color: var(--pill-text);
    background: var(--pill);
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-pill:hover { background: #cfe0ec; }

  .nav-pill.active {
    background: var(--accent);
    color: var(--white);
    font-weight: 600;
  }

  .about-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 32px 48px 80px;
  }

  .story-block {
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid var(--border);
    border-radius: 32px;
    padding: 32px 36px;
    box-shadow: 0 18px 40px rgba(43, 61, 79, 0.06);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--pill-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 24px;
    font-family: "Baloo 2", sans-serif;
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    color: var(--navy);
  }

  h2 {
    margin: 28px 0 12px;
    font-family: "Baloo 2", sans-serif;
    font-size: clamp(1.8rem, 2vw, 2.5rem);
    line-height: 1;
    color: var(--navy);
  }

  .story-block p,
  .story-block blockquote {
    margin: 0 0 18px;
    font-size: 1.02rem;
    line-height: 1.8;
    color: rgba(43, 61, 79, 0.85);
  }

  .story-block strong {
    color: var(--navy);
  }

  .story-block blockquote {
    margin: 28px 0;
    padding: 22px 24px;
    border-left: 4px solid var(--accent);
    background: rgba(143, 176, 199, 0.12);
    border-radius: 0 18px 18px 0;
    font-style: italic;
  }

  .brand-box {
    margin-top: 28px;
    background: rgba(255, 255, 255, 0.48);
    border: 1px solid var(--border);
    border-radius: 28px;
    padding: 26px 24px 22px;
    text-align: center;
    box-shadow: 0 14px 36px rgba(43, 61, 79, 0.05);
  }

  .brand-box-label {
    margin: 0 0 12px;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--pill-text);
  }

  .brand-link {
    display: inline-block;
    line-height: 0;
  }

  .brand-box-logo {
    display: block;
    width: min(100%, 360px);
    height: auto;
    margin: 0 auto;
  }

  .site-footer {
    padding: 24px 32px 36px;
    text-align: center;
    color: rgba(43, 61, 79, 0.7);
    font-size: 0.8rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--navy);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .topbar,
    .about-page {
      padding-left: 20px;
      padding-right: 20px;
    }

    .brand-mark {
      height: 56px;
    }

    .secondary-mark {
      height: 90px;
    }

    .nav {
      width: 100%;
      justify-content: center;
    }

    .nav-pill {
      padding: 10px 16px;
      font-size: 0.8rem;
    }

    .story-block {
      padding: 24px 20px;
    }
  }
</style>
