---
// src/pages/download.astro
// Download page styled to match the rest of the site.
const navItems = ["Home", "Features", "About", "Support", "Download"];
const activeItem = "Download";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Download | Brain of Bike</title>
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-logo2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <img class="brand-mark" src="/Logo3.png" alt="Brain of Bike logo" />
        <img class="secondary-mark" src="/Logo4.png" alt="Brain of Bike secondary logo" />
      </a>

      <nav class="nav">
        {navItems.map((item) => {
          const href = item === "Home" ? "/" : item === "Features" ? "/features" : item === "About" ? "/about" : item === "Support" ? "/support" : item === "Download" ? "/download" : "#";
          return <a href={href} class:list={["nav-pill", { active: item === activeItem }]}>{item}</a>;
        })}
      </nav>
    </header>

    <main class="download-page">
      <div class="download-card">
        <div class="icon-badge">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="white" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M16.365 1.43c0 1.14-.415 2.06-1.244 2.76-.995.85-2.06 1.21-3.19 1.12-.06-1.11.4-2.2 1.23-2.99.87-.83 2.13-1.27 3.2-1.34zM20.5 17.2c-.35.8-.77 1.55-1.27 2.25-.68.96-1.24 1.63-1.66 2-.66.6-1.36.9-2.11.92-.54.01-1.19-.15-1.95-.48-.76-.33-1.46-.49-2.09-.49-.66 0-1.38.16-2.15.49-.78.33-1.4.5-1.88.52-.72.03-1.44-.28-2.16-.94-.46-.4-1.05-1.1-1.76-2.09-.77-1.07-1.4-2.31-1.9-3.73-.53-1.54-.8-3.03-.8-4.47 0-1.65.36-3.07 1.07-4.26.56-.96 1.3-1.71 2.24-2.27.93-.56 1.94-.85 3.02-.87.57 0 1.32.18 2.26.53.94.35 1.54.53 1.81.53.2 0 .87-.2 2-.61 1.07-.38 1.97-.54 2.71-.48 2 .16 3.5.95 4.5 2.37-1.79 1.08-2.68 2.6-2.66 4.55.02 1.52.57 2.79 1.64 3.79.49.47 1.03.83 1.63 1.09-.13.38-.27.75-.42 1.11z"/>
          </svg>
        </div>
        <p class="coming-soon">Coming soon on the App Store</p>
      </div>
    </main>

    <footer class="site-footer">
      <p>Brain of bike · Made by CKT Ltd · Company No. 17451719 · Registered in England &amp; Wales · <a href="mailto:support@madebyckt.com">support@madebyckt.com</a> © 2026</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #eef3f8;
    --navy: #2b3d4f;
    --accent: #8fb0c7;
    --accent-soft: #d7e4ed;
    --pill: #dbe6ef;
    --pill-text: #6d818f;
    --white: #ffffff;
    --card-bg: rgba(255, 255, 255, 0.7);
    --border: rgba(43, 61, 79, 0.08);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    font-family: "Poppins", sans-serif;
    color: var(--navy);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px 0;
    flex-wrap: wrap;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: auto;
    height: 72px;
    object-fit: contain;
  }

  .secondary-mark {
    display: block;
    width: auto;
    height: 120px;
    object-fit: contain;
  }

  .nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nav-pill {
    text-decoration: none;
    color: var(--pill-text);
    background: var(--pill);
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-pill:hover { background: #cfe0ec; }

  .nav-pill.active {
    background: var(--accent);
    color: var(--white);
    font-weight: 600;
  }

  .download-page {
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px 64px;
  }

  .download-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid var(--border);
    border-radius: 32px;
    padding: 36px 32px;
    box-shadow: 0 18px 40px rgba(43, 61, 79, 0.06);
    text-align: center;
  }

  .icon-badge {
    width: 90px;
    height: 90px;
    border-radius: 24px;
    background: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .coming-soon {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 2rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--navy);
  }

  .site-footer {
    padding: 24px 32px 36px;
    text-align: center;
    color: rgba(43, 61, 79, 0.7);
    font-size: 0.8rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--navy);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .topbar,
    .download-page {
      padding-left: 20px;
      padding-right: 20px;
    }

    .brand-mark {
      height: 56px;
    }

    .secondary-mark {
      height: 90px;
    }

    .nav {
      width: 100%;
      justify-content: center;
    }

    .nav-pill {
      padding: 10px 16px;
      font-size: 0.8rem;
    }

    .download-card {
      padding: 28px 20px;
    }
  }
</style>
