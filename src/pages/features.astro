---
// src/pages/features.astro
// Feature overview page styled to match the home page.
const navItems = ["Home", "Features", "About", "Support", "Download"];
const activeItem = "Features";

const features = [
  {
    title: "Track your rides",
    body: "Automatically record your motorcycle journeys using GPS.",
    tone: "tone-1",
  },
  {
    title: "Understand your ride",
    body: "See useful ride statistics and summaries after each journey.",
    tone: "tone-2",
  },
  {
    title: "Discover spirited rides",
    body: "Identify rides that were more engaging or dynamic based on the GPS journey data.",
    tone: "tone-3",
  },
  {
    title: "Your riding history",
    body: "Keep a record of your journeys and look back at previous rides.",
    tone: "tone-4",
  },
  {
    title: "Share your adventures",
    body: "Create something you can share with friends after a ride.",
    tone: "tone-5",
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Features | Brain of Bike</title>
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-logo2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <img class="brand-mark" src="/Logo3.png" alt="Brain of Bike logo" />
        <img class="secondary-mark" src="/Logo4.png" alt="Brain of Bike secondary logo" />
      </a>

      <nav class="nav">
        {navItems.map((item) => {
          const href = item === "Home" ? "/" : item === "Features" ? "/features" : item === "About" ? "/about" : item === "Support" ? "/support" : item === "Download" ? "/download" : "#";
          return <a href={href} class:list={["nav-pill", { active: item === activeItem }]}>{item}</a>;
        })}
      </nav>
    </header>

    <main class="features-page">
      <section class="page-intro">
        <p class="eyebrow">Features</p>
        <h1>Built for the way you ride.</h1>
        <p class="intro-copy">
          Everything you need to understand every journey and share the moments that matter.
        </p>
      </section>

      <section class="feature-grid">
        {features.map((feature) => (
          <article class:list={["feature-card", feature.tone]}>
            <div class="card-icon">
              <img
                src={
                  feature.title === "Track your rides"
                    ? "/Rides%20Dark.svg"
                    : feature.title === "Discover spirited rides"
                      ? "/Flaming%20Tire%20Dark.svg"
                      : feature.title === "Understand your ride"
                        ? "/Cornering%20Dark.svg"
                        : feature.title === "Your riding history"
                          ? "/On%20Mount%20Dark.svg"
                          : feature.title === "Share your adventures"
                            ? "/Spirited%20Dark%20Mode.svg"
                            : "/Logo5.png"
                }
                alt=""
                aria-hidden="true"
              />
            </div>
            <h2>{feature.title}</h2>
            <p>{feature.body}</p>
          </article>
        ))}
      </section>
    </main>

    <footer class="site-footer">
      <p>Brain of bike · Made by CKT Ltd · Company No. 17451719 · Registered in England &amp; Wales · <a href="mailto:support@madebyckt.com">support@madebyckt.com</a> © 2026</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #eef3f8;
    --navy: #2b3d4f;
    --accent: #8fb0c7;
    --accent-soft: #d7e4ed;
    --pill: #dbe6ef;
    --pill-text: #6d818f;
    --white: #ffffff;
    --card-bg: rgba(255, 255, 255, 0.7);
    --border: rgba(43, 61, 79, 0.08);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    font-family: "Poppins", sans-serif;
    color: var(--navy);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px 0;
    flex-wrap: wrap;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: auto;
    height: 72px;
    object-fit: contain;
  }

  .secondary-mark {
    display: block;
    width: auto;
    height: 120px;
    object-fit: contain;
  }

  .nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nav-pill {
    text-decoration: none;
    color: var(--pill-text);
    background: var(--pill);
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-pill:hover { background: #cfe0ec; }

  .nav-pill.active {
    background: var(--accent);
    color: var(--white);
    font-weight: 600;
  }

  .features-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 48px 80px;
  }

  .page-intro {
    text-align: center;
    padding: 36px 0 26px;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--pill-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: "Baloo 2", sans-serif;
    font-size: clamp(2.4rem, 4vw, 4.5rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    color: var(--navy);
  }

  .intro-copy {
    max-width: 720px;
    margin: 16px auto 0;
    color: rgba(43, 61, 79, 0.7);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 22px;
    margin-top: 18px;
    justify-content: center;
    align-items: stretch;
    max-width: 980px;
    margin-left: auto;
    margin-right: auto;
  }

  .feature-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 30px;
    padding: 22px 20px 18px;
    box-shadow: 0 18px 40px rgba(43, 61, 79, 0.06);
    min-height: 210px;
    justify-self: center;
    width: 100%;
    max-width: 300px;
  }

  .card-icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1);
    margin-bottom: 18px;
  }

  .card-icon img {
    width: 50px;
    height: 50px;
    object-fit: contain;
  }

  .feature-card h2 {
    margin: 0 0 10px;
    font-size: 1.35rem;
    line-height: 1.2;
    color: var(--navy);
  }

  .feature-card p {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: rgba(43, 61, 79, 0.78);
  }

  .tone-1 .card-icon,
  .tone-2 .card-icon,
  .tone-3 .card-icon,
  .tone-4 .card-icon,
  .tone-5 .card-icon {
    background: #2b3d4f;
  }

  .site-footer {
    padding: 24px 32px 36px;
    text-align: center;
    color: rgba(43, 61, 79, 0.7);
    font-size: 0.8rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--navy);
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      max-width: 680px;
    }
  }

  @media (max-width: 720px) {
    .topbar,
    .features-page {
      padding-left: 20px;
      padding-right: 20px;
    }

    .brand-mark {
      height: 56px;
    }

    .secondary-mark {
      height: 90px;
    }

    .nav {
      width: 100%;
      justify-content: center;
    }

    .nav-pill {
      padding: 10px 16px;
      font-size: 0.8rem;
    }

    .feature-grid {
      grid-template-columns: 1fr;
      max-width: 300px;
    }
  }
</style>
