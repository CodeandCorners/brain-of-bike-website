---
// src/pages/index.astro
// "Brain of Bike" homepage — matches the supplied design mock.
const navItems = ["Home", "Features", "About", "Support", "Download"];
const activeItem = "Home";

const stats = [
  { label: "Cornering", value: 79 },
  { label: "Smoothness", value: 72 },
  { label: "Acceleration", value: 83 },
  { label: "Braking", value: 91 },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brain of Bike</title>
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-logo2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <img class="brand-mark" src="/Logo3.png" alt="Brain of Bike logo" />
        <img class="secondary-mark" src="/Logo4.png" alt="Brain of Bike secondary logo" />
      </a>

      <nav class="nav">
        {navItems.map((item) => {
          const href = item === "Home" ? "/" : item === "Features" ? "/features" : item === "About" ? "/about" : item === "Support" ? "/support" : item === "Download" ? "/download" : "#";
          return <a href={href} class:list={["nav-pill", { active: item === activeItem }]}>{item}</a>;
        })}
      </nav>
    </header>

    <main class="hero">
      <section class="hero-left">
        <div class="icon-tile">
          <img src="/Logo5.png" alt="Brain of Bike logo" class="hero-logo" />
        </div>

        <img src="/Logo4.png" alt="Brain of Bike wordmark" class="wordmark-logo" />

        <a href="#" class="store-btn coming-soon-btn" aria-label="Coming soon to the App Store">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="white" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M16.365 1.43c0 1.14-.415 2.06-1.244 2.76-.995.85-2.06 1.21-3.19 1.12-.06-1.11.4-2.2 1.23-2.99.87-.83 2.13-1.27 3.2-1.34zM20.5 17.2c-.35.8-.77 1.55-1.27 2.25-.68.96-1.24 1.63-1.66 2-.66.6-1.36.9-2.11.92-.54.01-1.19-.15-1.95-.48-.76-.33-1.46-.49-2.09-.49-.66 0-1.38.16-2.15.49-.78.33-1.4.5-1.88.52-.72.03-1.44-.28-2.16-.94-.46-.4-1.05-1.1-1.76-2.09-.77-1.07-1.4-2.31-1.9-3.73-.53-1.54-.8-3.03-.8-4.47 0-1.65.36-3.07 1.07-4.26.56-.96 1.3-1.71 2.24-2.27.93-.56 1.94-.85 3.02-.87.57 0 1.32.18 2.26.53.94.35 1.54.53 1.81.53.2 0 .87-.2 2-.61 1.07-.38 1.97-.54 2.71-.48 2 .16 3.5.95 4.5 2.37-1.79 1.08-2.68 2.6-2.66 4.55.02 1.52.57 2.79 1.64 3.79.49.47 1.03.83 1.63 1.09-.13.38-.27.75-.42 1.11z"/>
          </svg>
          <span class="store-text"><small>Coming soon to the</small><strong>App Store</strong></span>
        </a>
      </section>

      <section class="hero-right">
        <div class="phone">
          <div class="notch">
            <div class="pill-cam"></div>
          </div>

          <div class="screen">
            <img src="/bob summary page.png" alt="Bob summary page" class="phone-summary-image" />
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>Brain of bike · Made by CKT Ltd · Company No. 17451719 · Registered in England &amp; Wales · <a href="mailto:support@madebyckt.com">support@madebyckt.com</a> © 2026</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #eef3f8;
    --navy: #2b3d4f;
    --accent: #8fb0c7;
    --accent-soft: #d7e4ed;
    --pill: #dbe6ef;
    --pill-text: #6d818f;
    --white: #ffffff;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    font-family: "Poppins", sans-serif;
    color: var(--navy);
  }

  /* Header */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: auto;
    height: 72px;
    object-fit: contain;
  }

  .secondary-mark {
    display: block;
    width: auto;
    height: 120px;
    object-fit: contain;
  }

  .brand-name {
    font-family: "Baloo 2", sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--navy);
  }

  .nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nav-pill {
    text-decoration: none;
    color: var(--pill-text);
    background: var(--pill);
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-pill:hover { background: #cfe0ec; }

  .nav-pill.active {
    background: var(--accent);
    color: var(--white);
    font-weight: 600;
  }

  /* Hero */
  .hero {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 90px;
    padding: 20px 48px 100px;
    flex-wrap: wrap;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: -24px;
  }

  .icon-tile {
    width: 320px;
    height: 320px;
    max-width: 80vw;
    background: var(--navy);
    border-radius: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 30px 60px rgba(43, 61, 79, 0.25);
  }

  .hero-logo {
    width: 90%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .wordmark-logo {
    display: block;
    width: min(580px, 90vw);
    height: auto;
    object-fit: contain;
    margin: -32px 0 0;
  }

  .store-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--accent);
    color: var(--white);
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(143, 176, 199, 0.5);
  }

  .coming-soon-btn {
    margin-top: -48px;
  }

  .store-btn svg {
    margin-top: 0;
    flex-shrink: 0;
  }

  .store-text { display: flex; flex-direction: column; line-height: 1.2; }
  .store-text small { font-size: 0.72rem; font-weight: 400; }
  .store-text strong { font-size: 1.05rem; font-weight: 600; }

  /* Phone mockup */
  .phone {
    width: 300px;
    background: var(--navy);
    border-radius: 46px;
    padding: 14px;
    box-shadow: 0 40px 80px rgba(43, 61, 79, 0.35);
  }

  .notch {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 18px 10px;
    color: var(--white);
    font-size: 0.75rem;
  }

  .pill-cam {
    position: absolute;
    left: 50%;
    top: 4px;
    transform: translateX(-50%);
    width: 70px;
    height: 18px;
    background: #000;
    border-radius: 12px;
  }

  .status-icons { display: flex; gap: 6px; align-items: center; }
  .wifi, .battery { display: inline-block; width: 14px; height: 10px; border: 1px solid #fff; border-radius: 2px; }

  .screen {
    background: var(--bg);
    border-radius: 32px;
    padding: 0;
    overflow: hidden;
  }

  .phone-summary-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 32px;
  }

  .screen-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .screen-header h2 { font-size: 1.05rem; margin: 0; }
  .back, .chat {
    background: var(--white);
    border-radius: 50%;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }

  .ride-card, .map-card, .info-card {
    background: var(--white);
    border-radius: 18px;
    margin-bottom: 12px;
  }

  .ride-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
  }

  .ride-date { font-weight: 600; font-size: 0.85rem; margin: 0; }
  .ride-time { font-size: 0.72rem; color: #8b96a0; margin: 2px 0 0; }

  .ride-score {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .map-card {
    background: var(--accent-soft);
    padding: 14px;
  }

  .map-card svg { width: 100%; height: auto; display: block; }

  .info-card {
    display: flex;
    text-align: center;
    padding: 12px 0;
  }

  .info-card div {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-right: 1px solid #edf1f4;
  }

  .info-card div:last-child { border-right: none; }
  .info-card strong { font-size: 0.85rem; }
  .info-card span { font-size: 0.65rem; color: #8b96a0; }

  .ai-btn {
    width: 100%;
    background: var(--accent);
    color: var(--white);
    border: none;
    border-radius: 999px;
    padding: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 16px;
    cursor: pointer;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .stat-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .stat span { font-size: 0.62rem; color: #8b96a0; }

  .action-row {
    display: flex;
    gap: 10px;
    border-top: 1px solid #dfe6eb;
    padding-top: 14px;
  }

  .ghost-btn, .solid-btn {
    flex: 1;
    border-radius: 999px;
    padding: 10px;
    font-size: 0.8rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
  }

  .ghost-btn { background: var(--white); color: var(--navy); border: 1px solid #dfe6eb; }
  .solid-btn { background: var(--accent); color: var(--white); }

  .site-footer {
    text-align: center;
    padding: 18px 24px 28px;
    color: var(--navy);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--navy);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .hero { gap: 50px; }
    .wordmark { font-size: 2.4rem; }
  }

  @media (max-width: 480px) {
    .topbar { justify-content: center; }
    .nav { justify-content: center; }
  }
</style>
