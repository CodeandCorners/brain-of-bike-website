---
// src/pages/support.astro
// Support page styled to match the rest of the site.
const navItems = ["Home", "Features", "About", "Support", "Download"];
const activeItem = "Support";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Support | Brain of Bike</title>
    <link rel="icon" type="image/png" sizes="256x256" href="/favicon-logo2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <img class="brand-mark" src="/Logo3.png" alt="Brain of Bike logo" />
        <img class="secondary-mark" src="/Logo4.png" alt="Brain of Bike secondary logo" />
      </a>

      <nav class="nav">
        {navItems.map((item) => {
          const href = item === "Home" ? "/" : item === "Features" ? "/features" : item === "About" ? "/about" : item === "Support" ? "/support" : item === "Download" ? "/download" : "#";
          return <a href={href} class:list={["nav-pill", { active: item === activeItem }]}>{item}</a>;
        })}
      </nav>
    </header>

    <main class="support-page">
      <section class="support-card">
        <p class="eyebrow">Support</p>
        <h1>Need a hand? We’ve got you.</h1>

        <p>
          Got a question about our app, spotted a bug, or just want to say hello? We’re a small studio,
          so your message goes straight to the people who built the thing — not into a mysterious ticket queue.
        </p>

        <div class="support-section contact-panel">
          <h2>Get in touch</h2>

          <p class="contact-label"><strong>Email us</strong></p>
          <a class="email-link" href="mailto:support@madebyckt.com">support@madebyckt.com</a>

          <p>
            We aim to reply within <strong>1–2 working days</strong>. We’re a small team, so please bear with us if we occasionally take a little longer.
          </p>
        </div>

        <div class="support-section">
          <h2>What can we help with?</h2>

          <p><strong>Found a bug?</strong></p>
          <p>
            Tell us what happened, what you expected to happen, and what device you're using. Screenshots are always welcome.
          </p>

          <p><strong>Got an idea?</strong></p>
          <p>
            We'd love to hear it. Feature requests, improvements and wonderfully random ideas are all welcome.
          </p>

          <p><strong>Need help using the app?</strong></p>
          <p>
            If something isn't working as expected or you can't figure out how something works, drop us a message and we'll help you out.
          </p>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>Brain of bike · Made by CKT Ltd · Company No. 17451719 · Registered in England &amp; Wales · <a href="mailto:support@madebyckt.com">support@madebyckt.com</a> © 2026</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #eef3f8;
    --navy: #2b3d4f;
    --accent: #8fb0c7;
    --accent-soft: #d7e4ed;
    --pill: #dbe6ef;
    --pill-text: #6d818f;
    --white: #ffffff;
    --card-bg: rgba(255, 255, 255, 0.7);
    --border: rgba(43, 61, 79, 0.08);
    --text: #2b3d4f;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    font-family: "Poppins", sans-serif;
    color: var(--text);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px 0;
    flex-wrap: wrap;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .brand-mark {
    display: block;
    width: auto;
    height: 72px;
    object-fit: contain;
  }

  .secondary-mark {
    display: block;
    width: auto;
    height: 120px;
    object-fit: contain;
  }

  .nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nav-pill {
    text-decoration: none;
    color: var(--pill-text);
    background: var(--pill);
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-pill:hover { background: #cfe0ec; }

  .nav-pill.active {
    background: var(--accent);
    color: var(--white);
    font-weight: 600;
  }

  .support-page {
    max-width: 860px;
    margin: 0 auto;
    padding: 32px 48px 80px;
  }

  .support-card {
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid var(--border);
    border-radius: 32px;
    padding: 32px 36px;
    box-shadow: 0 18px 40px rgba(43, 61, 79, 0.06);
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--pill-text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 24px;
    font-family: "Baloo 2", sans-serif;
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    color: var(--navy);
  }

  h2 {
    margin: 18px 0 16px;
    font-family: "Baloo 2", sans-serif;
    font-size: clamp(1.8rem, 2vw, 2.5rem);
    line-height: 1;
    color: var(--navy);
  }

  .support-card p,
  .support-card a {
    margin: 0 0 18px;
    font-size: 1.02rem;
    line-height: 1.8;
    color: rgba(43, 61, 79, 0.85);
  }

  .support-card strong {
    color: var(--navy);
  }

  .support-section {
    margin-top: 14px;
  }

  .contact-panel {
    margin-top: 24px;
    padding: 22px 24px;
    background: rgba(143, 176, 199, 0.12);
    border: 2px solid rgba(43, 61, 79, 0.14);
    border-radius: 22px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .contact-label {
    margin-bottom: 8px;
  }

  .email-link {
    display: inline-block;
    margin-bottom: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(43, 61, 79, 0.12);
    font-weight: 700;
    color: var(--navy);
    text-decoration: none;
  }

  .email-link:hover {
    text-decoration: underline;
    background: rgba(255, 255, 255, 0.9);
  }

  .site-footer {
    padding: 24px 32px 36px;
    text-align: center;
    color: rgba(43, 61, 79, 0.7);
    font-size: 0.8rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    color: var(--navy);
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .topbar,
    .support-page {
      padding-left: 20px;
      padding-right: 20px;
    }

    .brand-mark {
      height: 56px;
    }

    .secondary-mark {
      height: 90px;
    }

    .nav {
      width: 100%;
      justify-content: center;
    }

    .nav-pill {
      padding: 10px 16px;
      font-size: 0.8rem;
    }

    .support-card {
      padding: 28px 20px;
    }
  }
</style>
