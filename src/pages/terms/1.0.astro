---
const navItems = ["Home", "Features", "About", "Support", "Download"];
const activeItem = "";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terms and Conditions | Brain of Bike</title>
    <link rel="icon" type="image/svg+xml" href="/Logo6.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="/">
        <img class="brand-mark" src="/Logo6.svg" alt="Brain of Bike logo" />
        <img class="secondary-mark" src="/Logo Text.png" alt="Brain of Bike secondary logo" />
      </a>

      <nav class="nav">
        {navItems.map((item) => {
          const href = item === "Home" ? "/" : item === "Features" ? "/features" : item === "About" ? "/about" : item === "Support" ? "/support" : item === "Download" ? "/download" : "#";
          return <a href={href} class:list={["nav-pill", { active: item === activeItem }]}>{item}</a>;
        })}
      </nav>
    </header>

    <main class="legal-page">
      <section class="legal-content">
        <h1>Terms and Conditions</h1>
        <p>Terms and conditions for Brain of Bike will be published here.</p>
        <p>
          Questions in the meantime? Email <a href="mailto:support@madebyckt.com">support@madebyckt.com</a>.
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <p>Brain of bike · Made by CKT Ltd · Company No. 17451719 · Registered in England &amp; Wales · <a href="mailto:support@madebyckt.com">support@madebyckt.com</a> © 2026</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --bg: #eef3f8;
    --navy: #2b3d4f;
    --pill: #dbe6ef;
    --pill-text: #6d818f;
    --border: rgba(43, 61, 79, 0.08);
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    font-family: "Poppins", sans-serif;
    color: var(--navy);
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 48px 0;
    flex-wrap: wrap;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }

  .brand-mark { display: block; width: auto; height: 120px; object-fit: contain; }
  .secondary-mark { display: block; width: auto; height: 64px; object-fit: contain; }

  .nav { display: flex; gap: 10px; flex-wrap: wrap; }

  .nav-pill {
    text-decoration: none;
    color: var(--pill-text);
    background: var(--pill);
    padding: 12px 24px;
    border-radius: 999px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .nav-pill:hover { background: #cfe0ec; }

  .legal-page {
    display: flex;
    justify-content: center;
    padding: 48px 24px 64px;
  }

  .legal-content {
    width: 100%;
    max-width: 720px;
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid var(--border);
    border-radius: 32px;
    padding: 36px 32px;
    box-shadow: 0 18px 40px rgba(43, 61, 79, 0.06);
  }

  .legal-content h1 { margin-top: 0; }
  .legal-content a { color: var(--navy); }

  .site-footer {
    padding: 24px 32px 36px;
    text-align: center;
    color: rgba(43, 61, 79, 0.7);
    font-size: 0.8rem;
  }

  .site-footer p { margin: 0; }
  .site-footer a { color: var(--navy); text-decoration: none; }

  @media (max-width: 720px) {
    .topbar, .legal-page { padding-left: 20px; padding-right: 20px; }
    .brand-mark { height: 90px; }
    .secondary-mark { height: 48px; }
    .nav { width: 100%; justify-content: center; }
    .nav-pill { padding: 10px 16px; font-size: 0.8rem; }
  }
</style>